{
  "name": "ai-plan-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "validate": "tsx scripts/validate.ts",
    "news:add": "tsx scripts/news-add.ts",
    "news:watch": "tsx scripts/watch.ts",
    "bench:sync": "tsx scripts/sync-swebench.ts",
    "bench:sync:aider": "tsx scripts/sync-aider.ts",
    "lint": "eslint .",
    "typecheck": "astro check",
