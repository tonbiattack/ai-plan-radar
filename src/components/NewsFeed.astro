---
import raw from '../data/news.json';
import { catalog } from '../lib/catalog';
import { newsCategoryKeys, newsDate, validateNews, groupRelatedNews } from '../lib/news';
import type { Locale } from '../i18n/locale';
import { getMessages, interpolate } from '../i18n/messages';
import { translateDataTextLoose } from '../i18n/data';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getMessages(locale);
const news = t.news;
const items = validateNews(
  raw,
  catalog.services.map((s) => s.id),
)
  .map((item) => ({
    ...item,
    title: translateDataTextLoose(item.title, locale) ?? item.title,
    summary: translateDataTextLoose(item.summary, locale) ?? item.summary,
    notes: translateDataTextLoose(item.notes, locale) ?? item.notes,
    facts: item.facts.map((fact) => translateDataTextLoose(fact, locale) ?? fact),
  }))
  .sort((a, b) => Date.parse(b.discoveredAt) - Date.parse(a.discoveredAt));
const names = [...new Set(items.map((item) => item.serviceName))].sort((a, b) =>
  a.localeCompare(b),
);
const groups = groupRelatedNews(items);
const hasNews = groups.length > 0;
---

<section
  class:list={['news container', { 'news-compact': !hasNews }]}
  id="news"
  aria-labelledby="news-heading"
>
  <div class="news-title">
    <h2 id="news-heading">{news.heading}</h2>
    <p>{news.intro}</p>
  </div>
  {hasNews && (
    <form class="news-filters" id="news-filters" role="search" aria-label={news.filtersLabel}>
      <label>
        {news.search}
        <input type="search" name="q" placeholder={news.searchPlaceholder} />
      </label>
      <label>
        {news.service}
        <select name="service">
          <option value="">{t.common.all}</option>
          {names.map((name) => (
            <option>{name}</option>
          ))}
        </select>
      </label>
      <label>
        {news.topic}
        <select name="category">
          <option value="">{t.common.all}</option>
          {newsCategoryKeys.map((value) => (
            <option value={value}>{news.categories[value]}</option>
          ))}
        </select>
      </label>
    </form>
  )}
  <noscript>
    <p>{news.noscript}</p>
  </noscript>
  <p
    id="news-count"
    role="status"
    aria-live="polite"
    hidden={!hasNews}
    data-template={t.counts.topics}
  >
    {interpolate(t.counts.topics, { count: groups.length })}
  </p>
  <div id="news-list">
    {groups.map((group) => {
      const item = group[0];
      return (
        <article
          class="news-item"
          data-news={item.id}
          data-names={JSON.stringify(group.map((entry) => entry.serviceName))}
          data-categories={JSON.stringify(group.map((entry) => entry.category))}
          data-search={group
            .map(
              (entry) =>
                `${entry.title} ${entry.summary} ${entry.serviceName} ${entry.facts.join(' ')}`,
            )
            .join(' ')}
        >
          <div class="news-meta">
            <span class:list={['news-status', item.status]}>{news.statuses[item.status]}</span>
            <span>{item.serviceName}</span>
            <span>{news.categories[item.category]}</span>
            <span>
              {news.discovered}{' '}
              <time datetime={item.discoveredAt}>{newsDate(item.discoveredAt, locale)}</time>
            </span>
          </div>
          <h2>{item.title}</h2>
          <p>{item.summary}</p>
          {item.status === 'breaking' && <p class="news-warning">{news.warning}</p>}
          {item.notes && <p>{item.notes}</p>}
          {item.publishedAt && (
            <p>
              {news.published}:{' '}
              <time datetime={item.publishedAt}>{newsDate(item.publishedAt, locale)}</time>
            </p>
          )}
          {item.reviewedAt && (
            <p>
              {news.reviewed}:{' '}
              <time datetime={item.reviewedAt}>{newsDate(item.reviewedAt, locale)}</time>
            </p>
          )}
          <p>
            <a href={item.sourceUrl} rel="noopener noreferrer">
              {news.readSource}
            </a>
          </p>
          {group.length > 1 && (
            <details>
              <summary>{interpolate(news.related, { count: group.length - 1 })}</summary>
              {group.slice(1).map((related) => (
                <div class="news-related" id={`news-${related.id}`}>
                  <p>
                    <strong>{related.title}</strong>{' '}
                    <span class:list={['news-status', related.status]}>
                      {news.statuses[related.status]}
                    </span>
                  </p>
                  <p>{related.summary}</p>
                  {related.notes && <p>{related.notes}</p>}
                  <p>
                    {news.discovered}{' '}
                    <time datetime={related.discoveredAt}>
                      {newsDate(related.discoveredAt, locale)}
                    </time>{' '}
                    /{' '}
                    <a href={related.sourceUrl} rel="noopener noreferrer">
                      {news.readSource}
                    </a>
                  </p>
                </div>
              ))}
            </details>
          )}
        </article>
      );
    })}
  </div>
  <p id="news-empty" hidden={items.length > 0}>
    {items.length ? news.noMatch : news.empty}
  </p>
  <p>
    <a href="https://github.com/tonbiattack/ai-plan-radar/issues">{news.contribute}</a>
  </p>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>('#news-filters');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-news]'));
  const empty = document.querySelector<HTMLElement>('#news-empty')!;
  const count = document.querySelector<HTMLElement>('#news-count')!;
  if (form) {
    const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase().trim();
    const template = count.dataset.template ?? '{count}';
    const update = () => {
      const values = new FormData(form);
      const q = normalize(String(values.get('q') ?? ''));
      const category = String(values.get('category') ?? '');
      const service = String(values.get('service') ?? '');
      let visible = 0;
      for (const card of cards) {
        card.hidden = Boolean(
          (q && !normalize(card.dataset.search ?? '').includes(q)) ||
          (category &&
            !(JSON.parse(card.dataset.categories ?? '[]') as string[]).includes(category)) ||
          (service && !(JSON.parse(card.dataset.names ?? '[]') as string[]).includes(service)),
        );
        if (!card.hidden) visible++;
      }
      count.textContent = template.replace('{count}', String(visible));
      empty.hidden = visible > 0;
    };
    form.addEventListener('input', update);
    form.addEventListener('change', update);
  }
</script>
