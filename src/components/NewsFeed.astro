---
import raw from '../data/news.json';
import { catalog } from '../lib/catalog';
import { categories, statuses, newsDate, validateNews, groupRelatedNews } from '../lib/news';
const items = validateNews(
  raw,
  catalog.services.map((s) => s.id),
).sort((a, b) => Date.parse(b.discoveredAt) - Date.parse(a.discoveredAt));
const names = [...new Set(items.map((item) => item.serviceName))].sort((a, b) =>
  a.localeCompare(b, 'ja'),
);
const groups = groupRelatedNews(items);
const hasNews = groups.length > 0;
---

<section
  class:list={['news container', { 'news-compact': !hasNews }]}
  id="news"
  aria-labelledby="news-heading"
>
  <div class="news-title">
    <h1 id="news-heading">AIサービスのニュース</h1>
    <p>
      プラン・料金・モデルなどの更新情報を、出典と確認状態を付けて掲載します。速報は未確認です。
    </p>
  </div>
  {hasNews && (
    <form class="news-filters" id="news-filters" role="search" aria-label="ニュースを絞り込む">
      <label>
        ニュース検索
        <input type="search" name="q" placeholder="サービス名・ニュース" />
      </label>
      <label>
        サービス
        <select name="service">
          <option value="">すべて</option>
          {names.map((name) => (
            <option>{name}</option>
          ))}
        </select>
      </label>
      <label>
        話題
        <select name="category">
          <option value="">すべて</option>
          {Object.entries(categories).map(([value, label]) => (
            <option value={value}>{label}</option>
          ))}
        </select>
      </label>
    </form>
  )}
  <noscript>
    <p>ニュースの絞り込みにはJavaScriptが必要です。</p>
  </noscript>
  <p id="news-count" role="status" aria-live="polite" hidden={!hasNews}>
    {groups.length}件の話題
  </p>
  <div id="news-list">
    {groups.map((group) => {
      const item = group[0];
      return (
        <article
          class="news-item"
          data-news={item.id}
          data-names={JSON.stringify(group.map((entry) => entry.serviceName))}
          data-categories={JSON.stringify(group.map((entry) => entry.category))}
          data-search={group
            .map(
              (entry) =>
                `${entry.title} ${entry.summary} ${entry.serviceName} ${entry.facts.join(' ')}`,
            )
            .join(' ')}
        >
          <div class="news-meta">
            <span class:list={['news-status', item.status]}>{statuses[item.status]}</span>
            <span>{item.serviceName}</span>
            <span>{categories[item.category]}</span>
            <span>
              発見 <time datetime={item.discoveredAt}>{newsDate(item.discoveredAt)}</time>
            </span>
          </div>
          <h2>{item.title}</h2>
          <p>{item.summary}</p>
          {item.status === 'breaking' && (
            <p class="news-warning">未確認の情報です。内容は変更・訂正される場合があります。</p>
          )}
          {item.notes && <p>{item.notes}</p>}
          {item.publishedAt && (
            <p>
              出典の公開日時: <time datetime={item.publishedAt}>{newsDate(item.publishedAt)}</time>
            </p>
          )}
          {item.reviewedAt && (
            <p>
              確認・更新日時: <time datetime={item.reviewedAt}>{newsDate(item.reviewedAt)}</time>
            </p>
          )}
          <p>
            <a href={item.sourceUrl} rel="noopener noreferrer">
              出典を確認する
            </a>
          </p>
          {group.length > 1 && (
            <details>
              <summary>関連情報・過去の更新（{group.length - 1}件）</summary>
              {group.slice(1).map((related) => (
                <div class="news-related" id={`news-${related.id}`}>
                  <p>
                    <strong>{related.title}</strong>{' '}
                    <span class:list={['news-status', related.status]}>
                      {statuses[related.status]}
                    </span>
                  </p>
                  <p>{related.summary}</p>
                  {related.notes && <p>{related.notes}</p>}
                  <p>
                    発見{' '}
                    <time datetime={related.discoveredAt}>{newsDate(related.discoveredAt)}</time> /{' '}
                    <a href={related.sourceUrl} rel="noopener noreferrer">
                      出典を確認する
                    </a>
                  </p>
                </div>
              ))}
            </details>
          )}
        </article>
      );
    })}
  </div>
  <p id="news-empty" hidden={items.length > 0}>
    {items.length
      ? '条件に合うニュースはありません。条件を変更してください。'
      : 'ニュースはまだありません。登録されるとここに表示されます。'}
  </p>
  <p>
    <a href="https://github.com/tonbiattack/ai-plan-radar/issues">情報の訂正・提供</a>
  </p>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>('#news-filters');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-news]'));
  const empty = document.querySelector<HTMLElement>('#news-empty')!;
  const count = document.querySelector<HTMLElement>('#news-count')!;
  if (form) {
    const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase('ja-JP').trim();
    const update = () => {
      const values = new FormData(form);
      const q = normalize(String(values.get('q') ?? ''));
      const category = String(values.get('category') ?? '');
      const service = String(values.get('service') ?? '');
      let visible = 0;
      for (const card of cards) {
        card.hidden = Boolean(
          (q && !normalize(card.dataset.search ?? '').includes(q)) ||
          (category &&
            !(JSON.parse(card.dataset.categories ?? '[]') as string[]).includes(category)) ||
          (service && !(JSON.parse(card.dataset.names ?? '[]') as string[]).includes(service)),
        );
        if (!card.hidden) visible++;
      }
      count.textContent = `${visible}件の話題`;
      empty.hidden = visible > 0;
    };
    form.addEventListener('input', update);
    form.addEventListener('change', update);
  }
</script>
