---
import { catalog as rawCatalog } from '../lib/catalog';
import { localizeCatalog } from '../i18n/data';
import { catalogFacts } from '../lib/views';
import { formatDate, serviceInitials, serviceAccent } from '../lib/format';
import { defaults } from '../lib/search';
import type { Locale } from '../i18n/locale';
import { getMessages, interpolate } from '../i18n/messages';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getMessages(locale);
const table = t.table;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const catalog = localizeCatalog(rawCatalog, locale);
const rows = catalogFacts(catalog, locale, defaults.currency as 'USD' | 'JPY');
const planCount = catalog.plans.length;
const prefix = `${base}/${locale}`;
---

<section id="service-views" aria-label={table.serviceCaption} data-plan-count={planCount}>
  <div class="view-switch" role="group" aria-label={table.viewLabel}>
    <button type="button" data-view="table" aria-pressed="true">
      {table.views.table}
    </button>
    <button type="button" data-view="plans" aria-pressed="false">
      {interpolate(table.views.plans, { count: planCount })}
    </button>
    <button type="button" data-view="cards" aria-pressed="false">
      {table.views.cards}
    </button>
    <a class="compare-link" href={`${prefix}/compare/`}>
      {table.compareLink}
    </a>
  </div>

  <div id="view-table" class="view-panel">
    <p class="table-note">{table.tableNote}</p>
    <div class="table-scroll">
      <table class="compare-table" id="service-table">
        <caption>{table.serviceCaption}</caption>
        <thead>
          <tr>
            <th scope="col">{table.serviceHeaders.service}</th>
            <th scope="col">{table.serviceHeaders.type}</th>
            <th scope="col">{table.serviceHeaders.plans}</th>
            <th scope="col">{table.serviceHeaders.free}</th>
            <th scope="col">{table.serviceHeaders.cheapest}</th>
            <th scope="col">{table.serviceHeaders.models}</th>
            <th scope="col">{table.serviceHeaders.allowance}</th>
            <th scope="col">{table.serviceHeaders.disclosure}</th>
            <th scope="col">{table.serviceHeaders.verified}</th>
          </tr>
        </thead>
        <tbody id="service-table-body">
          {rows.map((row) => (
            <tr
              data-service={row.id}
              data-category={row.category}
              data-type={row.type}
              data-free={row.free ? '1' : ''}
            >
              <th scope="row">
                <span class="service-cell">
                  <span
                    class="service-avatar"
                    style={`--avatar:${serviceAccent(row.id)}`}
                    aria-hidden="true"
                  >
                    {serviceInitials(row.name)}
                  </span>
                  <a href={`${prefix}/services/${row.slug}/`}>{row.name}</a>
                </span>
              </th>
              <td data-label={table.serviceHeaders.type}>
                {row.typeLabel}
                <span class="cell-sub">{row.category}</span>
              </td>
              <td data-label={table.serviceHeaders.plans}>{row.planCount}</td>
              <td data-label={table.serviceHeaders.free}>
                {row.free ? (
                  <span class="pill pill-free">{table.yes}</span>
                ) : (
                  <span class="pill">{table.no}</span>
                )}
              </td>
              <td data-label={table.serviceHeaders.cheapest}>
                <span
                  class:list={['price-cell', { 'price-free': row.cheapestLabel === t.common.free }]}
                >
                  {row.cheapestLabel}
                </span>
              </td>
              <td
                data-label={table.serviceHeaders.models}
                class:list={['cell-models', { 'cell-quiet': !row.hasConfirmedModels }]}
              >
                {row.modelsLabel}
              </td>
              <td data-label={table.serviceHeaders.allowance}>{row.limitsLabel}</td>
              <td data-label={table.serviceHeaders.disclosure}>
                <span class:list={['pill', { 'pill-known': row.disclosure === 'known' }]}>
                  {row.disclosureLabel}
                </span>
              </td>
              <td data-label={table.serviceHeaders.verified}>
                <time datetime={row.verifiedAt}>{formatDate(row.verifiedAt, locale)}</time>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div id="view-plans" class="view-panel" hidden>
    <p class="table-note">{table.plansNote}</p>
    <div class="table-scroll">
      <table class="compare-table" id="plan-table">
        <caption>{table.plansCaption}</caption>
        <thead>
          <tr>
            <th scope="col">{table.planHeaders.service}</th>
            <th scope="col">{table.planHeaders.plan}</th>
            <th scope="col">{table.planHeaders.billing}</th>
            <th scope="col">{table.planHeaders.price}</th>
            <th scope="col">{table.planHeaders.models}</th>
            <th scope="col">{table.planHeaders.limits}</th>
            <th scope="col">{table.planHeaders.disclosure}</th>
            <th scope="col">{table.planHeaders.verified}</th>
          </tr>
        </thead>
        <tbody id="plan-table-body">
          {rows.flatMap((row) =>
            row.plans.map((plan) => (
              <tr
                data-plan={plan.id}
                data-service={row.id}
                data-service-name={row.name}
                data-billing={plan.billing}
                data-free={plan.free ? '1' : ''}
                data-known={plan.hasKnownLimit ? '1' : ''}
                data-unknown={plan.hasUnknownLimit ? '1' : ''}
                data-models={plan.models.join(' ')}
                data-search={`${row.name} ${plan.name} ${plan.modelsLabel}`}
              >
                <th scope="row">
                  <a href={`${prefix}/services/${row.slug}/#${plan.id}`}>{row.name}</a>
                </th>
                <td data-label={table.planHeaders.plan}>{plan.name}</td>
                <td data-label={table.planHeaders.billing}>{plan.billingLabel}</td>
                <td data-label={table.planHeaders.price}>{plan.priceLabel}</td>
                <td data-label={table.planHeaders.models} class="cell-models">
                  {plan.modelsLabel}
                </td>
                <td data-label={table.planHeaders.limits}>{plan.limitLabel}</td>
                <td data-label={table.planHeaders.disclosure}>
                  <span class:list={['pill', { 'pill-known': plan.disclosure === 'known' }]}>
                    {plan.disclosureLabel}
                  </span>
                </td>
                <td data-label={table.planHeaders.verified}>
                  <time datetime={plan.verifiedAt}>{formatDate(plan.verifiedAt, locale)}</time>
                </td>
              </tr>
            )),
          )}
        </tbody>
      </table>
    </div>
  </div>

  <div id="view-cards" class="view-panel" hidden>
    <div id="service-list">
      {rows.map((row) => (
        <article
          class="service-card"
          data-service={row.id}
          data-category={row.category}
          data-type={row.type}
          data-free={row.free ? '1' : ''}
        >
          <div class="service-heading">
            <div class="service-identity">
              <span
                class="service-avatar service-avatar-lg"
                style={`--avatar:${serviceAccent(row.id)}`}
                aria-hidden="true"
              >
                {serviceInitials(row.name)}
              </span>
              <div>
                <span class="type-label">{row.typeLabel}</span>
                <h2>
                  <a href={`${prefix}/services/${row.slug}/`}>{row.name}</a>
                </h2>
              </div>
            </div>
            <div class="service-flags">
              <span class:list={['pill', row.free ? 'pill-free' : 'pill-paid']}>
                {row.free ? table.freePlanYes : table.freePlanNo}
              </span>
              <span class="service-price" data-free={row.free ? '1' : ''}>
                {row.cheapestLabel}
              </span>
            </div>
          </div>
          <p class="service-description">{row.category}</p>
          <div class="allowance-summary" data-allowances={row.limitsUnknown ? 'unknown' : 'known'}>
            <span class="allowance-label">{table.allowance}</span>
            {row.limitsUnknown ? (
              <span class="allowance-unknown">{table.allowanceUnknown}</span>
            ) : (
              <ul>
                {row.limitSummary.map((limit) => (
                  <li>{limit}</li>
                ))}
              </ul>
            )}
          </div>
          <p class:list={['model-summary', { 'model-summary-quiet': !row.hasConfirmedModels }]}>
            <span>{table.confirmedModels}</span> {row.modelsLabel}
          </p>
          <div class="card-bottom">
            <span>
              {t.common.verified}{' '}
              <time datetime={row.verifiedAt}>{formatDate(row.verifiedAt, locale)}</time>
            </span>
            <a class="detail-link" href={`${prefix}/services/${row.slug}/`}>
              {table.seePlans}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
