---
import '../styles/global.css';
import JsonLd from '../components/JsonLd.astro';
import type { Locale } from '../i18n/locale';
import {
  locales,
  localeHtmlLang,
  localeLabel,
  localeOg,
  otherLocale,
  withLocale,
} from '../i18n/locale';
import { getMessages } from '../i18n/messages';

interface Props {
  title?: string;
  description?: string;
  /** Path of the page below the site base, locale-free, e.g. `/models/`. */
  path?: string;
  type?: 'website' | 'article';
  /** Structured data (schema.org) for this page. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  locale: Locale;
}

const {
  title,
  description,
  path,
  type = 'website',
  structuredData,
  noindex = false,
  locale,
} = Astro.props;

const t = getMessages(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
/** Locale-free page path, used for canonical, hreflang and the switcher. */
const pagePath =
  path ??
  Astro.url.pathname
    .replace(base, '')
    .replace(/^\/(en|ja)(?=\/|$)/, '')
    .replace(/\/index\.html$/, '/');
const canonical = new URL(`${base}${withLocale(pagePath, locale)}`, Astro.site).toString();
const ogImage = new URL(`${base}/og.png`, Astro.site).toString();
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const alternates = locales.map((entry) => ({
  locale: entry,
  href: new URL(`${base}${withLocale(pagePath, entry)}`, Astro.site).toString(),
}));
/** Locale-free target for the switcher; the query string is added on the client. */
const switchTarget = `${base}${withLocale(pagePath, otherLocale(locale))}`;
---

<!doctype html>
<html lang={localeHtmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/favicon.svg`} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={localeOg[locale]} />
    {locales
      .filter((entry) => entry !== locale)
      .map((entry) => (
        <meta property="og:locale:alternate" content={localeOg[entry]} />
      ))}
    <meta property="og:site_name" content="AI Plan Radar" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    {structuredData && <JsonLd data={structuredData} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={`${base}/${locale}/`}>
          <img class="brand-icon" src={`${base}/favicon.svg`} width="40" height="40" alt="" />
          AI Plan <strong>Radar</strong>
          <span>{t.brand.tagline}</span>
        </a>
        <nav aria-label={t.nav.label}>
          <a href={`${base}/${locale}/#news`}>{t.nav.news}</a>
          <a href={`${base}/${locale}/`}>{t.nav.services}</a>
          <a href={`${base}/${locale}/compare/`}>{t.nav.compare}</a>
          <a href={`${base}/${locale}/models/`}>{t.nav.models}</a>
          <a href={`${base}/${locale}/history/`}>{t.nav.history}</a>
          <a href={`${base}/${locale}/about/`}>{t.nav.about}</a>
          <a
            id="lang-switch"
            class="lang-switch"
            href={switchTarget}
            hreflang={otherLocale(locale)}
            lang={otherLocale(locale)}
            data-base-href={switchTarget}
          >
            {localeLabel[otherLocale(locale)]}
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <strong>AI Plan Radar</strong>
        <p>{t.footer.disclaimer}</p>
        <a href={`${base}/${locale}/about/`}>{t.footer.about}</a>{' '}
        <a href="https://github.com/tonbiattack/ai-plan-radar/issues">{t.footer.report}</a>
        <p>
          {t.footer.related}
          <a href="https://tonbiattack.github.io/free-model-radar/en">{t.footer.relatedSite}</a>
        </p>
      </div>
    </footer>
    <script>
      // Keep the current query string (filters, selected plans, view) when the
      // reader switches language, so the same comparison stays on screen.
      const switcher = document.querySelector<HTMLAnchorElement>('#lang-switch');
      if (switcher?.dataset.baseHref) {
        switcher.href = `${switcher.dataset.baseHref}${location.search}`;
      }
    </script>
  </body>
</html>
