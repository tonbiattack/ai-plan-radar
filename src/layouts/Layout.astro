---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'AI Plan Radar | AIコーディングサービスの料金と利用枠',
  description = 'AIコーディングサービスの料金・対応モデル・利用制限を、公式出典と確認日付きで調べる日本語の非公式サイト。',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      本文へ移動
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={`${base}/`}>
          <img class="brand-icon" src={`${base}/favicon.svg`} width="40" height="40" alt="" />
          AI Plan <strong>Radar</strong>
          <span>料金と利用枠のリサーチ</span>
        </a>
        <nav aria-label="メインナビゲーション">
          <a href={`${base}/#news`}>ニュース</a>
          <a href={`${base}/`}>サービスを探す</a>
          <a href={`${base}/about/`}>掲載方針</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <strong>AI Plan Radar</strong>
        <p>
          各サービスとは提携していない非公式の情報サイトです。料金・モデル・制限の最新性は保証しません。購入前に必ず公式ページをご確認ください。
        </p>
        <a href={`${base}/about/`}>データの読み方・掲載方針</a>
        <a href="https://github.com/tonbiattack/ai-plan-radar/issues">誤りを報告する</a>
      </div>
    </footer>
  </body>
</html>
