---
import Layout from '../layouts/Layout.astro';
import { getMessages } from '../i18n/messages';
import { defaultLocale } from '../i18n/locale';

// The 404 page follows the default language. Astro's i18n routing generates
// the /en/ and /ja/ pages; a missing URL can arrive in either language, so this
// single page points back to the English start page.
const locale = defaultLocale;
const t = getMessages(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout locale={locale} title={t.notFound.title} noindex>
  <div class="container prose">
    <h1>{t.notFound.h1}</h1>
    <p>{t.notFound.body}</p>
    <a href={`${base}/${locale}/`}>{t.notFound.back}</a>
  </div>
</Layout>
