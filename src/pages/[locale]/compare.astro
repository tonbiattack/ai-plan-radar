---
import Layout from '../../layouts/Layout.astro';
import JsonPayload from '../../components/JsonPayload.astro';
import { catalog as rawCatalog } from '../../lib/catalog';
import { localizeCatalog } from '../../i18n/data';
import { planFacts } from '../../lib/views';
import { formatLimit, formatPrice } from '../../lib/format';
import { breadcrumbs } from '../../lib/seo';
import type { Locale } from '../../i18n/locale';
import { locales } from '../../i18n/locale';
import { getMessages, interpolate } from '../../i18n/messages';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = getMessages(locale);
const c = t.compare;
const catalog = localizeCatalog(rawCatalog, locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const plans = catalog.plans.map((plan) => {
  const service = catalog.services.find((entry) => entry.id === plan.serviceId)!;
  const facts = planFacts(catalog, plan, locale);
  return {
    ...facts,
    serviceName: service.name,
    serviceSlug: service.slug,
    serviceId: service.id,
    href: `${base}/${locale}/services/${service.slug}/#${plan.id}`,
    billing: facts.billingLabel,
    price: formatPrice(plan, locale),
    limits: plan.limits.map((limit) => ({
      metric: limit.metric,
      value: formatLimit(limit, locale),
      scope: limit.scope,
      window: limit.window,
      reset: limit.resetPolicy,
      overage: limit.overagePolicy,
      sourceUrl: limit.sourceUrl,
    })),
  };
});
/** Labels the inline script needs; kept in one place so both stay aligned. */
const scriptMessages = {
  countsSelected: t.counts.selected,
  item: c.item,
  perModel: c.perModel,
  rows: c.rows,
  notResearched: t.common.notResearched,
  dateLocale: locale === 'ja' ? 'ja-JP' : 'en-US',
};
---

<Layout
  locale={locale}
  title={c.title}
  description={c.description}
  path="/compare/"
  structuredData={breadcrumbs([
    { name: 'AI Plan Radar', path: `/${locale}/` },
    { name: c.title, path: `/${locale}/compare/` },
  ])}
>
  <div class="container compare-page">
    <header class="compare-header">
      <h1>{c.h1}</h1>
      <p>{c.intro}</p>
    </header>

    <section class="compare-picker" aria-labelledby="picker-title">
      <h2 id="picker-title">{c.pickerTitle}</h2>
      <p class="compare-note">{c.note}</p>
      <label class="compare-search">
        <span>{c.searchLabel}</span>
        <input id="compare-search" type="search" placeholder={c.searchPlaceholder} />
      </label>
      <div id="compare-options" class="compare-options" role="group" aria-label={c.optionsLabel}>
        {plans.map((plan) => (
          <label
            class="compare-option"
            data-plan-id={plan.id}
            data-search={`${plan.serviceName} ${plan.name} ${plan.modelsLabel}`}
          >
            <input type="checkbox" value={plan.id} />
            <span class="compare-option-name">
              <span class="compare-service">{plan.serviceName}</span>
              {plan.name}
            </span>
            <span class="compare-option-price">{plan.price}</span>
          </label>
        ))}
      </div>
    </section>

    <section class="compare-result" aria-labelledby="result-title">
      <h2 id="result-title">{c.resultTitle}</h2>
      <p id="compare-status" role="status" aria-live="polite">
        {interpolate(t.counts.selected, { count: 0 })}
      </p>
      <div id="compare-empty" class="compare-empty">
        <p>{c.empty}</p>
      </div>
      <div class="table-scroll">
        <table id="compare-table" class="compare-table compare-matrix" hidden>
          <caption>{c.caption}</caption>
          <thead>
            <tr id="compare-head"></tr>
          </thead>
          <tbody id="compare-body"></tbody>
        </table>
      </div>
      <p class="compare-note">{c.note2}</p>
    </section>
  </div>

  <JsonPayload id="compare-data" data={plans} />
  <JsonPayload id="compare-messages" data={scriptMessages} />
  <script>
    type ComparisonPlan = {
      id: string;
      serviceName: string;
      name: string;
      href: string;
      billing: string;
      price: string;
      modelsLabel: string;
      limits: {
        metric: string;
        value: string;
        scope: string;
        window: string;
        reset: string;
        overage: string;
      }[];
      verifiedAt: string;
      disclosureLabel: string;
    };
    type CompareMessages = {
      countsSelected: string;
      item: string;
      perModel: string;
      rows: {
        service: string;
        plan: string;
        billing: string;
        price: string;
        models: string;
        limits: string;
        disclosure: string;
        verified: string;
      };
      notResearched: string;
      dateLocale: string;
    };
    const data = JSON.parse(
      document.querySelector<HTMLScriptElement>('#compare-data')!.textContent!,
    ) as ComparisonPlan[];
    const msg = JSON.parse(
      document.querySelector<HTMLScriptElement>('#compare-messages')!.textContent!,
    ) as CompareMessages;
    const byId = new Map(data.map((plan) => [plan.id, plan]));
    const MAX = 4;
    const selected: string[] = [];
    const options = Array.from(document.querySelectorAll<HTMLElement>('.compare-option'));
    const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('.compare-option input'));
    const head = document.querySelector<HTMLTableRowElement>('#compare-head')!;
    const body = document.querySelector<HTMLTableSectionElement>('#compare-body')!;
    const table = document.querySelector<HTMLTableElement>('#compare-table')!;
    const status = document.querySelector<HTMLElement>('#compare-status')!;
    const empty = document.querySelector<HTMLElement>('#compare-empty')!;
    const search = document.querySelector<HTMLInputElement>('#compare-search')!;
    const formatDate = (value: string) =>
      new Intl.DateTimeFormat(msg.dateLocale, {
        timeZone: 'Asia/Tokyo',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).format(new Date(value));

    const rows: { label: string; render: (plan: ComparisonPlan) => string }[] = [
      {
        label: msg.rows.service,
        render: (plan) => `<a href="${plan.href}">${plan.serviceName}</a>`,
      },
      { label: msg.rows.plan, render: (plan) => plan.name },
      { label: msg.rows.billing, render: (plan) => plan.billing },
      { label: msg.rows.price, render: (plan) => plan.price },
      { label: msg.rows.models, render: (plan) => plan.modelsLabel },
      {
        label: msg.rows.limits,
        render: (plan) =>
          plan.limits.length
            ? plan.limits
                .map(
                  (limit) =>
                    `<span class="compare-limit"><strong>${limit.metric}</strong> ${limit.value}${
                      limit.scope === 'model' ? msg.perModel : ''
                    }</span>`,
                )
                .join('')
            : msg.notResearched,
      },
      {
        label: msg.rows.disclosure,
        render: (plan) => plan.disclosureLabel,
      },
      {
        label: msg.rows.verified,
        render: (plan) =>
          `<time datetime="${plan.verifiedAt}">${formatDate(plan.verifiedAt)}</time>`,
      },
    ];

    function render() {
      const chosen = selected.map((id) => byId.get(id)!).filter(Boolean);
      status.textContent = msg.countsSelected.replace('{count}', String(chosen.length));
      table.hidden = chosen.length === 0;
      empty.hidden = chosen.length > 0;
      head.replaceChildren();
      body.replaceChildren();
      if (!chosen.length) return;
      const corner = document.createElement('th');
      corner.scope = 'col';
      corner.textContent = msg.item;
      head.append(corner);
      for (const plan of chosen) {
        const cell = document.createElement('th');
        cell.scope = 'col';
        cell.textContent = `${plan.serviceName} / ${plan.name}`;
        head.append(cell);
      }
      for (const row of rows) {
        const tr = document.createElement('tr');
        const th = document.createElement('th');
        th.scope = 'row';
        th.textContent = row.label;
        tr.append(th);
        for (const plan of chosen) {
          const td = document.createElement('td');
          td.dataset.label = row.label;
          td.innerHTML = row.render(plan);
          tr.append(td);
        }
        body.append(tr);
      }
    }

    function syncUrl() {
      const url = new URL(location.href);
      if (selected.length) url.searchParams.set('plans', selected.join(','));
      else url.searchParams.delete('plans');
      if (url.href !== location.href) history.pushState(null, '', url);
    }

    function setSelection(ids: string[]) {
      selected.length = 0;
      for (const id of ids)
        if (byId.has(id) && !selected.includes(id) && selected.length < MAX) selected.push(id);
      for (const input of inputs) input.checked = selected.includes(input.value);
      render();
    }

    for (const input of inputs) {
      input.addEventListener('change', () => {
        if (input.checked) {
          selected.push(input.value);
          if (selected.length > MAX) {
            const dropped = selected.shift()!;
            const previous = inputs.find((entry) => entry.value === dropped);
            if (previous) previous.checked = false;
          }
        } else {
          const index = selected.indexOf(input.value);
          if (index >= 0) selected.splice(index, 1);
        }
        render();
        syncUrl();
      });
    }

    search.addEventListener('input', () => {
      const query = search.value.normalize('NFKC').toLocaleLowerCase().trim();
      for (const option of options) {
        option.hidden = Boolean(
          query &&
          !(option.dataset.search ?? '').normalize('NFKC').toLocaleLowerCase().includes(query),
        );
      }
    });

    window.addEventListener('popstate', () => {
      setSelection(
        new URLSearchParams(location.search).get('plans')?.split(',').filter(Boolean) ?? [],
      );
    });

    setSelection(
      new URLSearchParams(location.search).get('plans')?.split(',').filter(Boolean) ?? [],
    );
  </script>
</Layout>
