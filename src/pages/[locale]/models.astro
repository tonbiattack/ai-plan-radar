---
import Layout from '../../layouts/Layout.astro';
import raw from '../../data/swebench-verified.json';
import programbenchRaw from '../../data/programbench.json';
import aiderRaw from '../../data/aider-polyglot.json';
import { aiderSchema } from '../../lib/aider';
import { programbenchSchema } from '../../lib/programbench';
import { benchmarkDataSchema } from '../../lib/benchmark';
import { catalog as rawCatalog } from '../../lib/catalog';
import { localizeCatalog } from '../../i18n/data';
import { translateDataText } from '../../i18n/data';
import { formatDate } from '../../lib/format';
import { breadcrumbs } from '../../lib/seo';
import type { Locale } from '../../i18n/locale';
import { locales } from '../../i18n/locale';
import { getMessages, interpolate } from '../../i18n/messages';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = getMessages(locale);
const m = t.models;
const catalog = localizeCatalog(rawCatalog, locale);
const data = benchmarkDataSchema.parse(raw);
const programbench = programbenchSchema.parse(programbenchRaw);
const aider = aiderSchema.parse(aiderRaw);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}/${locale}`;
const linkedModelIds = new Set(data.results.map((result) => result.modelId).filter(Boolean));
const linkedModels = catalog.models.filter((model) => linkedModelIds.has(model.id));
const best = data.results[0].score;
const bestAider = aider.results[0].score;
const benchmarkDescription = translateDataText(data.benchmark.description, locale);
const benchmarkMetric = translateDataText(data.benchmark.metricLabel, locale);
const benchmarkNotes = translateDataText(data.benchmark.notes, locale);
const aiderCriterion = translateDataText(aider.selection.criterion, locale);
---

<Layout
  locale={locale}
  title={m.title}
  description={m.description}
  path="/models/"
  structuredData={breadcrumbs([
    { name: 'AI Plan Radar', path: `/${locale}/` },
    { name: m.h1, path: `/${locale}/models/` },
  ])}
>
  <div class="container benchmark-page">
    <header class="benchmark-header">
      <h1>{m.h1}</h1>
      <p>{m.intro}</p>
    </header>

    <section class="benchmark-card" aria-labelledby="programbench-title">
      <div class="benchmark-title">
        <div>
          <h2 id="programbench-title">ProgramBench</h2>
          <p>{m.programbench.description}</p>
        </div>
        <span class="badge">
          {interpolate(m.programbench.instances, { count: programbench.instances })}
        </span>
      </div>
      <p>{m.programbench.method}</p>
      <p>
        {m.programbench.updated}:{' '}
        <time datetime={programbench.sourceUpdatedAt}>
          {formatDate(programbench.sourceUpdatedAt, locale)}
        </time>{' '}
        / {m.programbench.checked}:{' '}
        <time datetime={programbench.retrievedAt}>
          {formatDate(programbench.retrievedAt, locale)}
        </time>{' '}
        / <a href={programbench.sourceUrl}>{m.programbench.leaderboard}</a>
      </p>
      <div class="benchmark-table-scroll">
        <table class="benchmark-table">
          <caption>{m.programbench.caption}</caption>
          <thead>
            <tr>
              <th scope="col">{m.programbench.headers.rank}</th>
              <th scope="col">{m.programbench.headers.model}</th>
              <th scope="col">{m.programbench.headers.resolved}</th>
              <th scope="col">{m.programbench.headers.almost}</th>
              <th scope="col">{m.programbench.headers.cost}</th>
            </tr>
          </thead>
          <tbody>
            {programbench.results.map((result, index) => (
              <tr>
                <td data-label={m.programbench.headers.rank}>{index + 1}</td>
                <th scope="row" data-label={m.programbench.headers.model}>
                  {result.model}
                </th>
                <td data-label={m.programbench.headers.resolved}>{result.resolved.toFixed(1)}%</td>
                <td data-label={m.programbench.headers.almost}>{result.almost.toFixed(1)}%</td>
                <td data-label={m.programbench.headers.cost}>
                  {result.cost === null ? m.programbench.unpublished : `$${result.cost.toFixed(2)}`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="benchmark-note">{m.programbench.note}</p>
    </section>

    <section class="benchmark-card" aria-labelledby="aider-title">
      <div class="benchmark-title">
        <div>
          <h2 id="aider-title">Aider Polyglot</h2>
          <p>{aiderCriterion}</p>
        </div>
        <span class="badge">{m.aider.maxCases}</span>
      </div>
      <p>{m.aider.method}</p>
      <dl class="benchmark-facts">
        <div>
          <dt>{m.aider.facts.metric}</dt>
          <dd>{m.aider.facts.metricValue}</dd>
        </div>
        <div>
          <dt>{m.aider.facts.updated}</dt>
          <dd>
            <time datetime={aider.sourceUpdatedAt}>
              {formatDate(aider.sourceUpdatedAt, locale)}
            </time>
          </dd>
        </div>
        <div>
          <dt>{m.aider.facts.checked}</dt>
          <dd>
            <time datetime={aider.retrievedAt}>{formatDate(aider.retrievedAt, locale)}</time>
          </dd>
        </div>
        <div>
          <dt>{m.aider.facts.source}</dt>
          <dd>
            <a href={aider.sourceUrl}>{m.aider.leaderboard}</a>
          </dd>
        </div>
      </dl>
      <p class="benchmark-note">{aiderCriterion}</p>
      <div class="benchmark-table-scroll">
        <table class="benchmark-table">
          <caption>{m.aider.caption}</caption>
          <thead>
            <tr>
              <th scope="col">{m.aider.headers.rank}</th>
              <th scope="col">{m.aider.headers.model}</th>
              <th scope="col">{m.aider.headers.score}</th>
              <th scope="col">{m.aider.headers.cost}</th>
              <th scope="col">{m.aider.headers.date}</th>
              <th scope="col">{m.aider.headers.version}</th>
              <th scope="col">{m.aider.headers.format}</th>
              <th scope="col">{m.aider.headers.cases}</th>
            </tr>
          </thead>
          <tbody>
            {aider.results.map((result, index) => (
              <tr>
                <td class="benchmark-rank" data-label={m.aider.headers.rank}>
                  {index + 1}
                </td>
                <th scope="row" data-label={m.aider.headers.model}>
                  <span class="benchmark-model">{result.model}</span>
                </th>
                <td data-label={m.aider.headers.score}>
                  <span class="benchmark-score">{result.score.toFixed(1)}%</span>
                  <span class="benchmark-bar" aria-hidden="true">
                    <span style={`width:${(result.score / bestAider) * 100}%`} />
                  </span>
                </td>
                <td data-label={m.aider.headers.cost}>
                  {result.costUsd === null ? m.aider.unpublished : `$${result.costUsd.toFixed(2)}`}
                </td>
                <td data-label={m.aider.headers.date}>
                  <time datetime={result.date}>{formatDate(result.date, locale)}</time>
                </td>
                <td data-label={m.aider.headers.version}>{result.version}</td>
                <td data-label={m.aider.headers.format}>{result.format}</td>
                <td data-label={m.aider.headers.cases}>{result.cases}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="benchmark-note">{m.aider.note}</p>
    </section>

    <section class="benchmark-card" aria-labelledby="benchmark-title">
      <div class="benchmark-title">
        <div>
          <h2 id="benchmark-title">{data.benchmark.name}</h2>
          <p>{benchmarkDescription}</p>
          <p>{m.swebench.evaluated}</p>
        </div>
        <span class="badge">
          {interpolate(m.swebench.instances, { count: data.benchmark.instances })}
        </span>
      </div>
      <dl class="benchmark-facts">
        <div>
          <dt>{m.swebench.facts.metric}</dt>
          <dd>{benchmarkMetric}</dd>
        </div>
        <div>
          <dt>{m.swebench.facts.harness}</dt>
          <dd>{interpolate(m.swebench.facts.harnessValue, { harness: data.benchmark.harness })}</dd>
        </div>
        <div>
          <dt>{m.swebench.facts.retrieved}</dt>
          <dd>
            <time datetime={data.benchmark.retrievedAt}>
              {formatDate(data.benchmark.retrievedAt, locale)}
            </time>
          </dd>
        </div>
        <div>
          <dt>{m.swebench.facts.source}</dt>
          <dd>
            <a href={data.benchmark.sourceUrl}>{m.swebench.leaderboard}</a>
          </dd>
        </div>
      </dl>

      <div class="benchmark-table-scroll">
        <table class="benchmark-table">
          <caption>{m.swebench.caption}</caption>
          <thead>
            <tr>
              <th scope="col">{m.swebench.headers.rank}</th>
              <th scope="col">{m.swebench.headers.model}</th>
              <th scope="col">{m.swebench.headers.score}</th>
              <th scope="col">{m.swebench.headers.cost}</th>
              <th scope="col">{m.swebench.headers.date}</th>
              <th scope="col">{m.swebench.headers.version}</th>
            </tr>
          </thead>
          <tbody>
            {data.results.map((result, index) => (
              <tr>
                <td class="benchmark-rank" data-label={m.swebench.headers.rank}>
                  {index + 1}
                </td>
                <th scope="row" data-label={m.swebench.headers.model}>
                  <span class="benchmark-model">{result.modelName}</span>
                  {result.modelOrg && <span class="benchmark-org">{result.modelOrg}</span>}
                </th>
                <td data-label={m.swebench.headers.score}>
                  <span class="benchmark-score">{result.score.toFixed(1)}%</span>
                  <span class="benchmark-bar" aria-hidden="true">
                    <span style={`width:${(result.score / best) * 100}%`} />
                  </span>
                </td>
                <td data-label={m.swebench.headers.cost}>
                  {result.instanceCostUsd === null
                    ? m.swebench.noCost
                    : `$${result.instanceCostUsd.toFixed(3)}`}
                </td>
                <td data-label={m.swebench.headers.date}>
                  <time datetime={result.evaluatedAt}>
                    {formatDate(result.evaluatedAt, locale)}
                  </time>
                </td>
                <td data-label={m.swebench.headers.version}>{result.harnessVersion}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="benchmark-note">{benchmarkNotes}</p>
    </section>

    <section class="benchmark-card">
      <h2>{m.pricing.title}</h2>
      <p>{m.pricing.body}</p>
      {linkedModels.length ? (
        <ul class="benchmark-links">
          {linkedModels.map((model) => (
            <li>
              <strong>{model.displayName}</strong>
              <span>
                {catalog.plans
                  .filter((plan) => plan.modelAccess.some((access) => access.modelId === model.id))
                  .map(
                    (plan) =>
                      catalog.services.find((service) => service.id === plan.serviceId)!.name,
                  )
                  .filter((name, index, names) => names.indexOf(name) === index)
                  .join(' / ')}
              </span>
              <a href={`${prefix}/?model=${model.id}`}>{m.pricing.link}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p>{m.pricing.empty}</p>
      )}
    </section>

    <section class="benchmark-card">
      <h2>{m.caveats.title}</h2>
      <ul class="benchmark-caveats">
        {m.caveats.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="benchmark-card">
      <h2>{m.regenerate.title}</h2>
      <p>
        <code>{m.regenerate.swebenchCommand}</code>
        {' / '}
        <code>{m.regenerate.aiderCommand}</code>
      </p>
      <p>{m.regenerate.body}</p>
      <p class="benchmark-data-links">
        <a href={data.benchmark.dataUrl}>{m.regenerate.dataLinks.swebench}</a>{' '}
        <a href={aider.dataUrl}>{m.regenerate.dataLinks.aider}</a>
      </p>
    </section>
  </div>
</Layout>
