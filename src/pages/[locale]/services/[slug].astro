---
import Layout from '../../../layouts/Layout.astro';
import { catalog as rawCatalog } from '../../../lib/catalog';
import { localizeCatalog } from '../../../i18n/data';
import { serviceSchema, breadcrumbs } from '../../../lib/seo';
import {
  formatPrice,
  formatLimit,
  formatDate,
  billingLabels,
  typeLabels,
  accessLabels,
  confidenceLabels,
  scopeLabels,
  isStale,
} from '../../../lib/format';
import type { Locale } from '../../../i18n/locale';
import { locales } from '../../../i18n/locale';
import { getMessages, interpolate } from '../../../i18n/messages';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    rawCatalog.services.map((service) => ({ params: { locale, slug: service.slug } })),
  );
}

const { locale, slug } = Astro.params as { locale: Locale; slug: string };
const t = getMessages(locale);
const d = t.detail;
const catalog = localizeCatalog(rawCatalog, locale);
const service = catalog.services.find((entry) => entry.slug === slug)!;
const plans = catalog.plans.filter((plan) => plan.serviceId === service.id);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}/${locale}`;
const availableModels = [
  ...new Set(
    plans.flatMap((plan) =>
      plan.modelAccess
        .filter((access) => ['available', 'conditional'].includes(access.availability))
        .map((access) => catalog.models.find((model) => model.id === access.modelId)?.displayName)
        .filter((name): name is string => Boolean(name)),
    ),
  ),
];
const description = interpolate(d.description, {
  name: service.name,
  plans: plans.length,
  models: availableModels.length
    ? interpolate(d.descriptionModels, {
        models: availableModels.slice(0, 6).join(locale === 'ja' ? '、' : ', '),
      })
    : '',
});
const structured = [
  breadcrumbs([
    { name: 'AI Plan Radar', path: `/${locale}/` },
    { name: service.name, path: `/${locale}/services/${service.slug}/` },
  ]),
  serviceSchema({
    name: service.name,
    description: service.description,
    slug: service.slug,
    officialUrl: service.officialUrl,
    verifiedAt: service.verifiedAt,
    offers: plans.map((plan) => ({
      name: plan.name,
      price: plan.price ? String(plan.price.amount) : null,
      currency: plan.price?.currency ?? null,
      period: plan.price
        ? { month: 'MONTH', year: 'YEAR', one_time: 'ONE_TIME' }[plan.price.period]
        : null,
    })),
  }),
];
const typeLabelsForLocale = typeLabels(locale);
const billingLabelsForLocale = billingLabels(locale);
const accessLabelsForLocale = accessLabels(locale);
const confidenceLabelsForLocale = confidenceLabels(locale);
const scopeLabelsForLocale = scopeLabels(locale);
---

<Layout
  locale={locale}
  title={interpolate(d.title, { name: service.name })}
  description={description}
  path={`/services/${service.slug}/`}
  type="article"
  structuredData={structured}
>
  <div class="container detail-page">
    <a class="back-link" href={`${prefix}/`}>
      {d.back}
    </a>
    <header class="detail-header">
      <span class="type-label">
        {typeLabelsForLocale[service.serviceType]} / {service.category}
      </span>
      <h1>{service.name}</h1>
      <p>{service.description}</p>
      <p class="metadata">
        {confidenceLabelsForLocale[service.confidence]} · {d.lastChecked}{' '}
        <time datetime={service.verifiedAt}>{formatDate(service.verifiedAt, locale)}</time>
        <span
          class="stale"
          data-verified={service.verifiedAt}
          hidden={!isStale(service.verifiedAt)}
        >
          {' '}
          · {d.stale}
        </span>
      </p>
      <p>
        {d.platforms}: {service.supportedPlatforms.join(' / ')}
      </p>
      <div class="official-links">
        <a href={service.officialUrl}>{d.officialSite}</a>
        <a href={service.pricingUrl}>{d.officialPricing}</a>
        <a href={`${prefix}/history/#service-${service.id}`}>{d.historyLink}</a>
      </div>
    </header>
    {service.serviceType === 'client' && (
      <aside class="notice">
        <strong>{d.clientNoticeTitle}</strong>
        <p>{d.clientNoticeBody}</p>
      </aside>
    )}
    {service.relatedServiceIds.length > 0 && (
      <p>
        {d.related}{' '}
        {service.relatedServiceIds.map((id) => {
          const related = catalog.services.find((entry) => entry.id === id)!;
          return (
            <a class="related-link" href={`${prefix}/services/${related.slug}/`}>
              {related.name}
            </a>
          );
        })}
      </p>
    )}
    <h2 class="section-title">{d.plansTitle}</h2>
    <p>{d.plansIntro}</p>
    <nav class="plan-nav" aria-label={d.planNav}>
      {plans.map((plan) => (
        <a href={`#${plan.id}`}>{plan.name}</a>
      ))}
    </nav>
    {plans.map((plan) => (
      <section class="plan-detail" id={plan.id}>
        <div class="plan-title">
          <h3>{plan.name}</h3>
          <span class="badge">{billingLabelsForLocale[plan.billingType]}</span>
        </div>
        <p class="plan-price">{formatPrice(plan, locale)}</p>
        <p>
          {plan.price?.taxNote ?? d.planPriceFallback}
          {plan.price?.promotionNote && ` / ${plan.price.promotionNote}`}
        </p>
        {plan.price?.period === 'year' && <p>{d.yearlyNote}</p>}
        <p>{plan.notes}</p>
        <h4>{d.modelsTitle}</h4>
        <p>{d.modelsIntro}</p>
        {plan.modelAccess.length ? (
          <ul class="model-list">
            {plan.modelAccess.map((access) => (
              <li>
                <strong>{catalog.models.find((m) => m.id === access.modelId)!.displayName}</strong>
                <span
                  class:list={[
                    'access-status',
                    { unavailable: access.availability === 'unavailable' },
                  ]}
                >
                  {accessLabelsForLocale[access.availability]}
                </span>
                <p>{access.notes}</p>
                {plan.limits.filter(
                  (limit) => limit.scope === 'model' && limit.targetId === access.modelId,
                ).length ? (
                  <ul class="model-limits">
                    {plan.limits
                      .filter(
                        (limit) => limit.scope === 'model' && limit.targetId === access.modelId,
                      )
                      .map((limit) => (
                        <li>
                          <strong>
                            {limit.metric}: {formatLimit(limit, locale)}
                          </strong>
                          <p>{limit.notes}</p>
                          <p>
                            {d.limitReset}: {limit.resetPolicy} / {d.limitOverage}:{' '}
                            {limit.overagePolicy}
                          </p>
                          <a href={limit.sourceUrl}>{d.modelLimitSource}</a>
                        </li>
                      ))}
                  </ul>
                ) : (
                  <p>{d.modelLimitsMissing}</p>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p>{d.noModels}</p>
        )}
        <h4>{d.limitsTitle}</h4>
        <div class="limits">
          {plan.limits
            .filter((limit) => limit.scope !== 'model')
            .map((limit) => (
              <div class="limit-item">
                <div class="limit-heading">
                  <strong>{limit.metric}</strong>
                  <span>{formatLimit(limit, locale)}</span>
                </div>
                <dl>
                  <div>
                    <dt>{d.limitScope}</dt>
                    <dd>
                      {scopeLabelsForLocale[limit.scope]}
                      {limit.targetId && `: ${limit.targetId}`}
                    </dd>
                  </div>
                  <div>
                    <dt>{d.limitWindow}</dt>
                    <dd>{limit.window}</dd>
                  </div>
                  <div>
                    <dt>{d.limitReset}</dt>
                    <dd>{limit.resetPolicy}</dd>
                  </div>
                  <div>
                    <dt>{d.limitOverage}</dt>
                    <dd>{limit.overagePolicy}</dd>
                  </div>
                  <div>
                    <dt>{d.limitRollover}</dt>
                    <dd>{limit.rolloverPolicy}</dd>
                  </div>
                </dl>
                <p>{limit.notes}</p>
                <a href={limit.sourceUrl}>{d.limitSource}</a>
              </div>
            ))}
        </div>
        {!plan.limits.some((limit) => limit.scope !== 'model') && <p>{d.noPlanLimits}</p>}
        <div class="plan-sources">
          <p>
            {confidenceLabelsForLocale[plan.confidence]} · {d.planChecked}{' '}
            <time datetime={plan.verifiedAt}>{formatDate(plan.verifiedAt, locale)}</time>
          </p>
          <a href={plan.pricingUrl}>{d.planSources}</a>
          <details>
            <summary>{interpolate(d.sourcesSummary, { count: plan.sources.length })}</summary>
            <ul>
              {plan.sources.map((source) => (
                <li>
                  <a href={source.url}>{source.url}</a>{' '}
                  {interpolate(d.sourceCheckedOn, {
                    date: formatDate(source.verifiedAt, locale),
                  })}
                </li>
              ))}
            </ul>
          </details>
        </div>
      </section>
    ))}
    <section class="service-sources">
      <h2>{d.serviceSources}</h2>
      <ul>
        {service.sources.map((source) => (
          <li>
            <a href={source.url}>{source.url}</a>{' '}
            {interpolate(d.sourceCheckedOn, { date: formatDate(source.verifiedAt, locale) })}
          </li>
        ))}
      </ul>
    </section>
  </div>
  <script>
    import { isStale } from '../../../lib/format';
    for (const element of document.querySelectorAll<HTMLElement>('[data-verified]'))
      element.hidden = !isStale(element.dataset.verified!);
  </script>
</Layout>
