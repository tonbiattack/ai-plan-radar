---
// The site root has no language yet, so it sends visitors to English (the
// default language). Astro needs an index page when every locale is prefixed.
// A meta refresh keeps the static export working on GitHub Pages, which cannot
// serve HTTP redirects for arbitrary paths.
import { defaultLocale } from '../i18n/locale';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/${defaultLocale}/`;
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <title>AI Plan Radar</title>
    <link rel="canonical" href={`https://tonbiattack.github.io${target}`} />
    <link rel="alternate" hreflang="en" href={`https://tonbiattack.github.io${base}/en/`} />
    <link rel="alternate" hreflang="ja" href={`https://tonbiattack.github.io${base}/ja/`} />
    <link rel="alternate" hreflang="x-default" href={`https://tonbiattack.github.io${base}/en/`} />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>
      <a href={target}>AI Plan Radar</a>
    </p>
  </body>
</html>
