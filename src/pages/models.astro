---
import Layout from '../layouts/Layout.astro';
import raw from '../data/swebench-verified.json';
import { benchmarkDataSchema } from '../lib/benchmark';
import { catalog } from '../lib/catalog';
import { formatDate } from '../lib/format';
const data = benchmarkDataSchema.parse(raw);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const linkedModelIds = new Set(data.results.map((result) => result.modelId).filter(Boolean));
const linkedModels = catalog.models.filter((model) => linkedModelIds.has(model.id));
const best = data.results[0].score;
---

<Layout
  title="モデル性能（SWE-bench Verified）| AI Plan Radar"
  description="AIコーディングモデルのSWE-bench Verified（Bash Only）結果を、評価条件・出典・評価日付きで一覧表示します。"
>
  <div class="container benchmark-page">
    <header class="benchmark-header">
      <h1>モデル性能</h1>
      <p>
        同じ評価環境で測られたコーディング性能を比較します。点数だけでなく、評価ハーネス・版・評価日・出典を併記します。
      </p>
    </header>

    <section class="benchmark-card" aria-labelledby="benchmark-title">
      <div class="benchmark-title">
        <div>
          <h2 id="benchmark-title">{data.benchmark.name}</h2>
          <p>{data.benchmark.description}</p>
        </div>
        <span class="badge">{data.benchmark.instances}問</span>
      </div>
      <dl class="benchmark-facts">
        <div>
          <dt>指標</dt>
          <dd>{data.benchmark.metricLabel}</dd>
        </div>
        <div>
          <dt>評価ハーネス</dt>
          <dd>{data.benchmark.harness}（全結果で共通）</dd>
        </div>
        <div>
          <dt>取得日</dt>
          <dd>
            <time datetime={data.benchmark.retrievedAt}>
              {formatDate(data.benchmark.retrievedAt)}
            </time>
          </dd>
        </div>
        <div>
          <dt>出典</dt>
          <dd>
            <a href={data.benchmark.sourceUrl}>SWE-bench公式リーダーボード</a>
          </dd>
        </div>
      </dl>

      <div class="benchmark-table-scroll">
        <table class="benchmark-table">
          <caption>SWE-bench Verified Bash Onlyの解決率。上から高い順。</caption>
          <thead>
            <tr>
              <th scope="col">順位</th>
              <th scope="col">モデル</th>
              <th scope="col">解決率</th>
              <th scope="col">1問あたりコスト</th>
              <th scope="col">評価日</th>
              <th scope="col">ハーネス版</th>
            </tr>
          </thead>
          <tbody>
            {data.results.map((result, index) => (
              <tr>
                <td class="benchmark-rank" data-label="順位">
                  {index + 1}
                </td>
                <th scope="row" data-label="モデル">
                  <span class="benchmark-model">{result.modelName}</span>
                  {result.modelOrg && <span class="benchmark-org">{result.modelOrg}</span>}
                </th>
                <td data-label="解決率">
                  <span class="benchmark-score">{result.score.toFixed(1)}%</span>
                  <span class="benchmark-bar" aria-hidden="true">
                    <span style={`width:${(result.score / best) * 100}%`} />
                  </span>
                </td>
                <td data-label="1問あたりコスト">
                  {result.instanceCostUsd === null
                    ? '未算定'
                    : `$${result.instanceCostUsd.toFixed(3)}`}
                </td>
                <td data-label="評価日">
                  <time datetime={result.evaluatedAt}>{formatDate(result.evaluatedAt)}</time>
                </td>
                <td data-label="ハーネス版">{result.harnessVersion}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="benchmark-note">{data.benchmark.notes}</p>
    </section>

    <section class="benchmark-card">
      <h2>料金データとの対応</h2>
      <p>
        ベンチマークのモデル名と料金データのモデルが完全一致した場合のみ関連付けています。系列名だけの料金プランを、特定バージョンの性能と結び付けません。
      </p>
      {linkedModels.length ? (
        <ul class="benchmark-links">
          {linkedModels.map((model) => (
            <li>
              <strong>{model.displayName}</strong>
              <span>
                {catalog.plans
                  .filter((plan) => plan.modelAccess.some((access) => access.modelId === model.id))
                  .map(
                    (plan) =>
                      catalog.services.find((service) => service.id === plan.serviceId)!.name,
                  )
                  .filter((name, index, names) => names.indexOf(name) === index)
                  .join(' / ')}
              </span>
              <a href={`${base}/?model=${model.id}`}>このモデルが使えるプランを探す</a>
            </li>
          ))}
        </ul>
      ) : (
        <p>現在、ベンチマーク結果と完全一致するモデルは料金データにありません。</p>
      )}
    </section>

    <section class="benchmark-card">
      <h2>この数値を読むときの注意</h2>
      <ul class="benchmark-caveats">
        <li>
          SWE-benchはPythonリポジトリのIssue解決を測る指標です。UI生成や文章作成、長期的な保守性は評価しません。
        </li>
        <li>
          解決率はハーネス・プロンプト・推論設定・評価日で変わります。本ページはmini-SWE-agentの同一設定に限定しています。
        </li>
        <li>
          1問あたりコストは評価時点のAPI料金による概算で、現在の料金やプラン価格ではありません。
        </li>
        <li>
          コーディングエージェント製品の性能は、モデル単体の結果に加え、製品側のツールやコンテキスト管理にも依存します。
        </li>
        <li>
          モデルの版が変われば性能も変わります。購入判断では公式の最新情報も確認してください。
        </li>
      </ul>
      <p>
        数値の取得は <code>npx tsx scripts/sync-swebench.ts</code>
        で行い、<a href={data.benchmark.dataUrl}>公開データ</a>から再生成できます。
      </p>
    </section>
  </div>
</Layout>
